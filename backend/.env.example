PORT=4000

# Ganti dengan secret acak yang kuat.
JWT_SECRET=replace-with-a-long-random-secret

# Isi menggunakan API key Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key

# Model Gemini yang digunakan.
GEMINI_MODEL=gemini-3.5-flash-lite

# Daftar origin frontend yang diizinkan CORS, dipisahkan koma.
# Default: https://studytrack-frontend.pages.dev,http://localhost:5173
CORS_ORIGINS=https://studytrack-frontend.pages.dev,http://localhost:5173
